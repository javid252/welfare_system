# Copy relevant values into your local shell/.env, or set them manually in
# the Render dashboard under your service -> Environment (not needed if you
# deploy via render.yaml as a Blueprint — those are set automatically).

DJANGO_SECRET_KEY=change-this-to-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=.onrender.com
# DATABASE_URL is provided automatically by Render's PostgreSQL add-on.
# Locally, leave it unset to fall back to SQLite.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Set to "true" to auto-populate demo employees/services/activities/holidays
# on every build (safe to re-run).
SEED_DEMO_DATA=false
